local function setupScriptUserDetection()
    local WhitelistedAuthors = {
        ["iiiii11111iiiii6"] = true,
    }
    
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local isAuthor = WhitelistedAuthors[LocalPlayer.Name] or false
    
    local function markAsScriptUser()
        pcall(function()
            LocalPlayer:SetAttribute("IsScriptUser", true)
            LocalPlayer:SetAttribute("ScriptVersion", "1.0")
        end)
    end
    
    local function detectOtherScriptUsers()
        local detectedUsers = {}
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local isScriptUser = player:GetAttribute("IsScriptUser")
                if isScriptUser then
                    table.insert(detectedUsers, player.Name)
                end
            end
        end
        
        return detectedUsers
    end
    
    markAsScriptUser()
    
    if isAuthor then
        local function createDetectionButton()
            local DetectionGui = Instance.new("ScreenGui")
            DetectionGui.Name = "DetectionGui"
            DetectionGui.ResetOnSpawn = false
            DetectionGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
            
            local DetectionButton = Instance.new("ImageButton")
            DetectionButton.Name = "DetectionButton"
            DetectionButton.Size = UDim2.new(0, 50, 0, 50)
            DetectionButton.Position = UDim2.new(0, 10, 0.5, -25)
            DetectionButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            DetectionButton.BackgroundTransparency = 0.5
            DetectionButton.Image = "rbxassetid://96836146608996"
            DetectionButton.Active = true
            DetectionButton.Draggable = true
            DetectionButton.Parent = DetectionGui
            
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = DetectionButton
            
            DetectionButton.MouseButton1Click:Connect(function()
                local detectedUsers = detectOtherScriptUsers()
                
                if #detectedUsers == 0 then
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "脚本检测",
                        Text = "暂未检测到使用同款脚本的其他玩家",
                        Duration = 5,
                    })
                else
                    local function showUserNotification(index)
                        if index <= #detectedUsers then
                            local userName = detectedUsers[index]
                            game:GetService("StarterGui"):SetCore("SendNotification", {
                                Title = "脚本检测",
                                Text = "检测完毕 玩家 " .. userName .. " 正在使用同款脚本",
                                Duration = 4,
                            })
                            
                            wait(4.5)
                            showUserNotification(index + 1)
                        end
                    end
                    
                    showUserNotification(1)
                end
            end)
            
            DetectionButton.MouseEnter:Connect(function()
                game:GetService("TweenService"):Create(
                    DetectionButton,
                    TweenInfo.new(0.2),
                    {BackgroundTransparency = 0.2}
                ):Play()
            end)
            
            DetectionButton.MouseLeave:Connect(function()
                game:GetService("TweenService"):Create(
                    DetectionButton,
                    TweenInfo.new(0.2),
                    {BackgroundTransparency = 0.5}
                ):Play()
            end)
            
            return DetectionButton
        end
        
        local success, detectionButton = pcall(createDetectionButton)
        if success and detectionButton then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "作者模式",
                Text = "脚本用户检测按钮已创建",
                Duration = 5,
            })
            
            print("脚本用户检测按钮已创建 - 作者模式")
        end
    else
        print("脚本用户已标记: " .. LocalPlayer.Name)
    end
end

