                    Part.Velocity = Network.Velocity
                end
            end
        end)
    end

    EnablePartControl()
end

local radius = 50
local height = 100
local rotationSpeed = 10
local attractionStrength = 1000
local ringPartsEnabled = false
local tiltAngle = 0 -- 0 = horizontal, 90 = vertical
local followView = false -- 跟随视角开关
local savedDirection = Vector3.new(0, 0, 1) -- 默认向前方向

local function RetainPart(Part)
    if Part:IsA("BasePart") and not Part.Anchored and Part:IsDescendantOf(workspace) then
        if Part.Parent == LocalPlayer.Character or Part:IsDescendantOf(LocalPlayer.Character) then
            return false
        end
        Part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        Part.CanCollide = false
        return true
    end
    return false
end

local parts = {}

local function addPart(part)
    if RetainPart(part) then
        if not table.find(parts, part) then
            table.insert(parts, part)
        end
    end
end

local function removePart(part)
    local index = table.find(parts, part)
    if index then
        table.remove(parts, index)
    end
end

for _, part in pairs(workspace:GetDescendants()) do
    addPart(part)
end

workspace.DescendantAdded:Connect(addPart)
workspace.DescendantRemoving:Connect(removePart)

-- 修复后的环绕逻辑
RunService.Heartbeat:Connect(function()
    if not ringPartsEnabled then return end

    local humanoidRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if humanoidRootPart then
        local tornadoCenter = humanoidRootPart.Position
        local currentTime = tick()

        for i, part in pairs(parts) do
            if part.Parent and not part.Anchored then
                local pos = part.Position

                -- 计算零件在环绕中的角度位置
                local angle = (currentTime * rotationSpeed + i * 0.1) % (2 * math.pi)

                local targetPos
                
                if followView then
                    -- 跟随视角模式：使用摄像头方向计算环绕位置
                    local camera = workspace.CurrentCamera
                    local cameraCF = camera.CFrame
                    local cameraLook = cameraCF.LookVector
                    local cameraRight = cameraCF.RightVector
                    local cameraUp = cameraCF.UpVector
                    
                    -- 创建一个垂直于视角方向的环绕平面
                    -- 使用右向量和上向量来构建环绕圆
                    local circleX = math.cos(angle) * radius
                    local circleY = math.sin(angle) * radius
                    
                    -- 将2D圆映射到3D空间，使用摄像头的右向量和上向量
                    targetPos = tornadoCenter + (cameraRight * circleX + cameraUp * circleY)
                    
                    -- 记录当前方向
                    savedDirection = cameraLook
                else
                    -- 原始模式：使用倾斜角度计算
                    local tiltRad = math.rad(tiltAngle)

                    -- 统一计算公式，确保始终为圆形
                    local finalX = math.cos(angle) * radius
                    local verticalY = math.sin(angle) * radius * math.sin(tiltRad)
                    local finalZ = math.sin(angle) * radius * math.cos(tiltRad)

                    -- 使用保存的方向来计算环绕位置
                    local forward = savedDirection
                    local right = Vector3.new(forward.Z, 0, -forward.X).Unit
                    local up = Vector3.new(0, 1, 0)
                    
                    -- 如果方向不是完全水平，计算正确的右向量和上向量
                    if math.abs(forward.Y) > 0.001 then
                        right = Vector3.new(forward.Z, 0, -forward.X).Unit
                        up = right:Cross(forward).Unit
                    end

                    targetPos = tornadoCenter + (right * finalX + up * verticalY + forward * finalZ)
                end

                -- 确保零件不会太靠近玩家
                local distanceToCenter = (targetPos - tornadoCenter).Magnitude
                if distanceToCenter < radius * 0.3 then
                    -- 如果太靠近中心，向外推
                    local direction = (targetPos - tornadoCenter).Unit
                    targetPos = tornadoCenter + direction * (radius * 0.3)
                end

                local directionToTarget = (targetPos - part.Position).Unit
                part.Velocity = directionToTarget * attractionStrength
            end
        end
    end
end)

